TRACCAR_IMAGE_TAG=6.15.3-dev.5eb9578
DOCKER_NETWORK=backend

# The MySQL container must be attached to DOCKER_NETWORK, or MYSQL_HOST must
# resolve to an externally reachable MySQL server from the Traccar container.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=traccar
MYSQL_USER=traccar
MYSQL_PASSWORD=change-me
